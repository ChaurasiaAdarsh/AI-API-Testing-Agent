# Auto detect text files and perform LF normalization on checkin
* text=auto

# Source code files - enforce LF line endings
*.java text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.css text eol=lf
*.html text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.properties text eol=lf

# Scripts
*.sh text eol=lf
mvnw text eol=lf
*.cmd text eol=crlf
*.bat text eol=crlf
mvnw.cmd text eol=crlf

# Binary files
*.jar binary
*.war binary
*.class binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg text
