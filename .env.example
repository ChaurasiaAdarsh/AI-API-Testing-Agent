# ================================================================
# AI API Testing Agent - Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to git
# ================================================================

# --- Database ---
DATABASE_NAME=api_testing
DATABASE_URL=jdbc:postgresql://localhost:5432/api_testing
DATABASE_USERNAME=apitest
DATABASE_PASSWORD=apitest

# --- AI Configuration ---
# Option 1: Ollama (local, recommended for development)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Option 2: Use a hosted provider (configure in application.yml)
# AI_PROVIDER=openai
# AI_API_KEY=sk-...
# AI_MODEL=gpt-4o-mini

# --- Security ---
# Set to false for local development to test your own APIs
APP_TESTING_DEMO_MODE=false
# Comma-separated list of allowed hosts. Empty = allow all (when demoMode=false)
APP_TESTING_ALLOWED_HOSTS=
APP_TESTING_MAX_CONCURRENCY=5
APP_TESTING_TIMEOUT_SECONDS=10

# --- Demo API ---
APP_DEMO_DEFECTS_ENABLED=true

# --- Frontend/CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
VITE_API_URL=http://localhost:8080
